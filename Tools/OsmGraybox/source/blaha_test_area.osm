  <tag k="inscription" v="Itt működött az EMKE Kávéház 1893 - 1995 között Az 1949-es államosításig olyan legendás kávésmesterek vezették mint az alapító Wassermann Jónás és fia Mór, Bermann József és felesége, Fruzsina, majd vejük Muskát László. Emlékükre állíttatta Erzsébetváros"/>
  <tag k="material" v="marble"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="EMKE kávéház"/>
  <tag k="start_date" v="2024"/>
  <tag k="wikimedia_commons" v="File:EMKE emléktábla.jpg"/>
 </node>
